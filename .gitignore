# .gitignore

# Environment variables (SENSITIVE - DO NOT COMMIT!)
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE settings
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/
log/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebooks
.ipynb_checkpoints/

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Audio files (optional - can be large)
*.mp3
*.wav
*.flac

# Images (optional - can be large)
*.jpg
*.jpeg
*.png
*.gif
*.bmp

# API keys file (if you create one)
api_keys.json
config.json
credentials.json

# Backup files
*.bak
*.backup